digraph BioETL_Pipelines {
    rankdir=LR;
    node [shape=box, fontsize=10];

    subgraph cluster_core {
        label = "bioetl.core";
        style=filled;
        color="#eeeeff";

        core_pipeline_common   [label="core.pipeline.common\nPipelineBaseCommon"];
        core_pipeline_errors   [label="core.pipeline.errors"];
        core_pipeline_init     [label="core.pipeline.__init__"];
        core_runtime_runner    [label="core.runtime.cli_pipeline_runner\nPipelineCommandRunner"];
        core_io_output         [label="core.io.output"];
        core_io_base_writer    [label="core.io.base_writer"];
        core_config_contracts  [label="core.config_contracts"];
        core_logging           [label="core.logging.*"];
        core_schema            [label="core.schema.*"];
        core_utils_common      [label="core.common\nChemblReleaseMixin"];
        core_utils_molecule    [label="core.utils.molecule_map\njoin_activity_with_molecule"];
    }

    subgraph cluster_pipelines {
        label = "bioetl.pipelines";
        style=filled;
        color="#ffeeee";

        pipelines_init         [label="pipelines.__init__"];
        pipelines_base         [label="pipelines.base\nPipelineBase"];
        pipelines_validation   [label="pipelines.validation\n*ValidationStep"];
        pipelines_unified_base [label="pipelines.unified_base\nUnifiedPipelineBase"];
        chembl_common          [label="pipelines.chembl.common"];
        chembl_stage_runner    [label="pipelines.chembl.stage_runner"];
        chembl_activity        [label="pipelines.chembl.activity.run\nChemblActivityPipeline"];
        chembl_assay           [label="pipelines.chembl.assay.run\nChemblAssayPipeline"];
        chembl_document        [label="pipelines.chembl.document.run\nChemblDocumentPipeline"];
        chembl_target          [label="pipelines.chembl.target.run\nChemblTargetPipeline"];
        chembl_testitem        [label="pipelines.chembl.testitem.run\nTestItemChemblPipeline"];
    }

    /* core internal */
    core_pipeline_init -> core_pipeline_common;
    core_pipeline_init -> core_pipeline_errors;
    core_runtime_runner -> core_pipeline_init;
    core_pipeline_common -> core_io_output;
    core_pipeline_common -> core_logging;
    core_pipeline_common -> core_schema;
    core_pipeline_common -> core_config_contracts;
    core_pipeline_common -> core_utils_common;
    core_utils_common -> core_utils_molecule;

    /* pipelines internal */
    pipelines_base -> core_pipeline_common;
    pipelines_validation -> core_io_output;
    pipelines_validation -> core_logging;
    pipelines_validation -> core_schema;
    pipelines_validation -> pipelines_base;  // via pipeline methods
    pipelines_unified_base -> pipelines_base;
    pipelines_unified_base -> chembl_common;
    chembl_stage_runner -> pipelines_unified_base;
    chembl_stage_runner -> pipelines_validation;

    pipelines_init -> chembl_activity;
    pipelines_init -> chembl_assay;
    pipelines_init -> chembl_document;
    pipelines_init -> chembl_target;
    pipelines_init -> chembl_testitem;
    pipelines_init -> pipelines_base;

    chembl_activity -> pipelines_unified_base;
    chembl_assay   -> pipelines_unified_base;
    chembl_document-> pipelines_unified_base;
    chembl_target  -> pipelines_unified_base;
    chembl_testitem-> pipelines_unified_base;

    /* CLI -> pipelines */
    core_runtime_runner -> pipelines_init      [style=dashed, label="via PipelineFactory"];
}
